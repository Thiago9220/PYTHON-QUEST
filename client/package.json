{
  "name": "python-quest",
  "private": true,
  "version": "0.1.0",
  "description": "Python Quest: The Rise of the Scriptweaver — Interactive Python, Data Science, Git, Docker, Networking & Cybersecurity RPG.",
  "author": "Thiago Ramos",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "steam:window": "electron .",
    "steam:build": "tsc && vite build --mode steam && electron .",
    "steam:exe": "tsc && vite build --mode steam && electron-builder --win dir",
    "steam:installer": "tsc && vite build --mode steam && electron-builder --win nsis",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.thiagoramos.pythonquest",
    "productName": "Python Quest",
    "asar": false,
    "directories": {
      "output": "release/steam"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "dir",
        "nsis"
      ],
      "icon": "public/assets/images/python-protocol-mark.ico"
    }
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.2.6",
    "@supabase/supabase-js": "^2.106.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "framer-motion": "^11.3.0",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sonner": "^1.5.0",
    "steamworks.js": "^0.4.0",
    "tailwind-merge": "^2.2.1",
    "tw-animate-css": "^1.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.18",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.2.2",
    "vite": "^8.0.13"
  }
}
